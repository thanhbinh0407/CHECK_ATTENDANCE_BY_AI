@startuml 05_Leave_Request_Management_Sequence_Diagram

title Leave Request Management & Approval Workflow Sequence Diagram

actor "Employee" as EMP
participant "Employee Portal" as EP
participant "LeaveController" as LC
participant "LeaveService" as LS
participant "ApprovalWorkflowService" as AWS
participant "LeaveRequestModel" as LRM
participant "ApprovalWorkflowModel" as AWM
participant "EmployeeModel" as EM
participant "NotificationService" as NS
participant "EmailService" as ES
participant "Database" as DB

== Submit Leave Request ==
EMP -> EP: Fill leave request form
EP -> LC: POST /api/leave/request
LC -> LS: createLeaveRequest(requestData)
LS -> LS: validateLeaveRequest(requestData)
LS -> EM: getEmployeeById(employeeId)
EM -> DB: SELECT * FROM employees WHERE id = ?
DB --> EM: employee
EM --> LS: employee
LS -> LS: checkLeaveBalance(employee, leaveType, daysRequested)
LS -> LS: checkLeavePolicy(employee, leaveType, dates)
LS -> LRM: createLeaveRequest(requestData)
LRM -> DB: INSERT INTO leave_requests (employeeId, leaveType, startDate, ...)
DB --> LRM: requestId
LRM --> LS: requestId
LS -> AWS: initiateApprovalWorkflow(requestId, 'leave_request')
AWS -> AWS: determineApprovalLevels(employee.department, leaveType, days)
AWS -> AWM: createApprovalWorkflow(workflowData)
AWM -> DB: INSERT INTO approval_workflows (requestId, level, approverId, ...)
DB --> AWM: workflowId
AWM --> AWS: workflowId
AWS -> NS: notifyApprovers(workflowId)
NS -> ES: sendApprovalNotification(approvers, requestDetails)
ES --> NS: notifications sent
NS --> AWS: success
AWS --> LS: workflow initiated
LS --> LC: {requestId, status: 'pending'}
LC --> EP: request submitted successfully
EP --> EMP: Show success message

== Multi-Level Approval Process ==
note over AWS: Approval workflow triggered
AWS -> AWS: getNextApprover(workflowId)
AWS -> AWM: findPendingApprovals(workflowId)
AWM -> DB: SELECT * FROM approval_workflows WHERE requestId = ? AND status = 'pending' ORDER BY level
DB --> AWM: pendingApprovals
AWM --> AWS: nextApproval
AWS -> AWS: notifyApprover(nextApproval.approverId)

note over EP: Approver receives notification
EP -> LC: GET /api/approvals/pending
LC -> AWS: getPendingApprovals(approverId)
AWS -> AWM: findApprovalsByApprover(approverId, 'pending')
AWM -> DB: SELECT * FROM approval_workflows WHERE approverId = ? AND status = 'pending'
DB --> AWM: pendingApprovals
AWM --> AWS: pendingApprovals
AWS -> AWS: enrichWithRequestData(pendingApprovals)
AWS --> LC: enrichedApprovals
LC --> EP: pending approvals list

EP -> LC: GET /api/leave/{requestId}/details
LC -> LS: getLeaveRequestDetails(requestId)
LS -> LRM: findLeaveRequestById(requestId)
LRM -> DB: SELECT * FROM leave_requests WHERE id = ?
DB --> LRM: request
LRM --> LS: request
LS -> AWS: getApprovalHistory(requestId)
AWS -> AWM: findApprovalsByRequestId(requestId)
AWM -> DB: SELECT * FROM approval_workflows WHERE requestId = ?
DB --> AWM: approvals
AWM --> AWS: approvals
AWS --> LS: approvalHistory
LS -> LS: combineRequestData(request, approvalHistory)
LS --> LC: detailedRequest
LC --> EP: leave request details

== Approve Leave Request ==
note over EP: Approver reviews and approves
EP -> LC: PUT /api/approvals/{approvalId}/approve
LC -> AWS: approveRequest(approvalId, approverId, comments)
AWS -> AWM: findApprovalById(approvalId)
AWM -> DB: SELECT * FROM approval_workflows WHERE id = ?
DB --> AWM: approval
AWM --> AWS: approval
AWS -> AWS: validateApprovalPermission(approverId, approval)
AWS -> AWM: updateApprovalStatus(approvalId, 'approved', comments, approverId)
AWM -> DB: UPDATE approval_workflows SET status = 'approved', approvedAt = NOW(), comments = ?
DB --> AWM: updated
AWM --> AWS: success
AWS -> AWS: checkIfAllLevelsApproved(approval.requestId)
AWS -> AWM: countPendingApprovals(approval.requestId)
AWM -> DB: SELECT COUNT(*) FROM approval_workflows WHERE requestId = ? AND status = 'pending'
DB --> AWM: pendingCount
AWM --> AWS: pendingCount

alt All levels approved
    AWS -> LS: finalizeLeaveApproval(approval.requestId)
    LS -> LRM: updateLeaveRequestStatus(approval.requestId, 'approved')
    LRM -> DB: UPDATE leave_requests SET status = 'approved', approvedAt = NOW()
    DB --> LRM: updated
    LRM --> LS: success
    LS -> LS: updateLeaveBalance(employeeId, leaveType, daysRequested)
    LS -> EM: deductLeaveBalance(employeeId, leaveType, daysRequested)
    EM -> DB: UPDATE employees SET annualLeaveBalance = annualLeaveBalance - ?
    DB --> EM: updated
    EM --> LS: success
    LS -> NS: notifyEmployeeApproval(employeeId, requestId)
    NS -> ES: sendApprovalConfirmation(employee.email, requestDetails)
    ES --> NS: email sent
else More levels pending
    AWS -> AWS: notifyNextApprover(approval.requestId)
    AWS -> AWM: getNextPendingApproval(approval.requestId)
    AWM -> DB: SELECT * FROM approval_workflows WHERE requestId = ? AND status = 'pending' ORDER BY level LIMIT 1
    DB --> AWM: nextApproval
    AWM --> AWS: nextApproval
    AWS -> NS: notifyNextApprover(nextApproval)
end

AWS --> LC: approval processed
LC --> EP: approval successful

== Reject Leave Request ==
EP -> LC: PUT /api/approvals/{approvalId}/reject
LC -> AWS: rejectRequest(approvalId, approverId, rejectionReason)
AWS -> AWM: updateApprovalStatus(approvalId, 'rejected', rejectionReason, approverId)
AWM -> DB: UPDATE approval_workflows SET status = 'rejected', approvedAt = NOW(), comments = ?
DB --> AWM: updated
AWM --> AWS: success
AWS -> LS: finalizeLeaveRejection(approval.requestId)
LS -> LRM: updateLeaveRequestStatus(approval.requestId, 'rejected')
LRM -> DB: UPDATE leave_requests SET status = 'rejected', rejectedAt = NOW(), rejectionReason = ?
DB --> LRM: updated
LRM --> LS: success
LS -> NS: notifyEmployeeRejection(employeeId, requestId, rejectionReason)
NS -> ES: sendRejectionNotification(employee.email, requestDetails, rejectionReason)
ES --> NS: email sent
NS --> AWS: notifications sent
AWS --> LC: rejection processed
LC --> EP: rejection successful

== Leave Balance Management ==
EMP -> EP: View leave balance
EP -> LC: GET /api/leave/balance
LC -> LS: getLeaveBalance(employeeId)
LS -> EM: getEmployeeLeaveBalances(employeeId)
EM -> DB: SELECT annualLeaveBalance, sickLeaveBalance, maternityLeaveBalance FROM employees WHERE id = ?
DB --> EM: balances
EM --> LS: balances
LS -> LS: calculateUsedLeave(employeeId, currentYear)
LS -> LRM: getApprovedLeaveDays(employeeId, currentYear)
LRM -> DB: SELECT SUM(days) FROM leave_requests WHERE employeeId = ? AND year(startDate) = ? AND status = 'approved'
DB --> LRM: usedDays
LRM --> LS: usedDays
LS -> LS: calculateRemainingBalance(balances, usedDays)
LS --> LC: leaveBalance
LC --> EP: leave balance data
EP --> EMP: Display leave balances

== Leave Calendar Integration ==
EMP -> EP: View leave calendar
EP -> LC: GET /api/leave/calendar?month=12&year=2024
LC -> LS: getLeaveCalendarData(month, year, department)
LS -> LRM: getApprovedLeavesByMonth(month, year)
LRM -> DB: SELECT employeeId, startDate, endDate, leaveType FROM leave_requests WHERE MONTH(startDate) = ? AND YEAR(startDate) = ? AND status = 'approved'
DB --> LRM: approvedLeaves
LRM --> LS: approvedLeaves
LS -> LS: formatCalendarEvents(approvedLeaves)
LS -> LS: addPublicHolidays(month, year)
LS --> LC: calendarData
LC --> EP: calendar events
EP --> EMP: Display leave calendar

== Leave Report Generation ==
note over EP: HR generates leave reports
EP -> LC: GET /api/reports/leave?month=12&year=2024&department=IT
LC -> LS: generateLeaveReport(filters)
LS -> LRM: getLeaveDataByFilters(filters)
LRM -> DB: SELECT * FROM leave_requests WHERE MONTH(startDate) = ? AND YEAR(startDate) = ? AND department = ?
DB --> LRM: leaveData
LRM --> LS: leaveData
LS -> LS: processLeaveStatistics(leaveData)
LS -> LS: calculateLeaveUtilization(leaveData)
LS -> LS: formatReportData(statistics)
LS --> LC: reportData
LC -> LC: exportReportToExcel(reportData)
LC -> LC: exportReportToPDF(reportData)
LC --> EP: report files
EP --> EMP: Download leave reports

@enduml</content>
