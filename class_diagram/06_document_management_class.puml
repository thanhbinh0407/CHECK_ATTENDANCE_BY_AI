Document --> DocumentType : references
DocumentController --> DocumentService : uses
DocumentController --> FileUploadService : uses
DocumentService --> DocumentModel : uses
DocumentService --> DocumentAuditModel : uses
DocumentService --> FileUploadService : uses
DocumentService --> NotificationService : uses
DocumentService --> PermissionService : uses
FileUploadService --> StorageProvider : uses
FileUploadService --> FileValidator : uses
FileUploadService --> SecurityScanner : uses
DocumentModel --> Document : manages
DocumentAuditModel --> DocumentAudit : manages

' DTOs
class UploadDocumentRequest {
    +employeeId: Integer
    +documentType: String
    +file: File
    +title: String
    +expiryDate: Date
    +metadata: Object
}

class UploadDocumentResponse {
    +success: Boolean
    +document: DocumentDTO
    +message: String
}

class DocumentDTO {
    +id: Integer
    +documentType: String
    +title: String
    +fileName: String
    +fileSize: Integer
    +fileUrl: String
    +expiryDate: Date
    +uploadedAt: DateTime
    +uploadedBy: UserDTO
}

class SearchDocumentsRequest {
    +query: String
    +documentType: String
    +employeeId: Integer
    +dateFrom: Date
    +dateTo: Date
    +page: Integer
    +limit: Integer
    +sortBy: String
    +sortOrder: String
}

class SearchDocumentsResponse {
    +documents: DocumentDTO[]
    +pagination: PaginationInfo
    +totalCount: Integer
}

class FileInfo {
    +fileName: String
    +filePath: String
    +fileUrl: String
    +fileSize: Integer
    +mimeType: String
    +uploadedAt: DateTime
}

class ValidationResult {
    +isValid: Boolean
    +errors: String[]
    +warnings: String[]
}

class ScanResult {
    +isSafe: Boolean
    +threats: ThreatInfo[]
    +scanTime: DateTime
}

