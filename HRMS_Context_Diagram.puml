@startuml Context Diagram - Human Resource Management System

!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2

title Context Diagram - Human Resource Management System

' System boundary
rectangle "Human Resource Management System" as HRMS #LightBlue {
    rectangle "Face Attendance Backend" as FAB
    rectangle "Face Attendance Frontend" as FAF
    rectangle "Employee Portal" as EP
    rectangle "Accountant Client" as AC
    rectangle "Payroll Frontend" as PF
    rectangle "Login Portal" as LP
    rectangle "Face Attendance Employee App" as FAEA
}

' External Actors
actor "Employee" as EMP #LightGreen
actor "Accountant" as ACC #LightGreen
actor "Administrator" as ADM #LightGreen
actor "HR Manager" as HRM #LightGreen

' External Systems
database "PostgreSQL Database" as DB #LightYellow
cloud "Face Recognition Service" as FRS #LightYellow
cloud "Email Service" as ES #LightYellow
cloud "Camera System" as CS #LightYellow
cloud "Biometric Device" as BD #LightYellow

' Relationships - Data Flow and Interactions
EMP --> LP : Authentication
EMP --> EP : Salary Information
EMP --> FAEA : Attendance Recording
EMP --> BD : Biometric Data

ACC --> LP : Authentication
ACC --> AC : Payroll Management
ACC --> AC : Insurance Forms
ACC --> AC : Financial Reports

ADM --> LP : Authentication
ADM --> FAF : System Administration
ADM --> FAF : Employee Management
ADM --> FAF : Configuration Management

HRM --> LP : Authentication
HRM --> FAF : HR Operations
HRM --> EP : Employee Data Access

' System to External Systems
HRMS --> DB : Data Storage
HRMS --> FRS : Face Recognition
HRMS --> ES : Email Notifications
HRMS --> CS : Camera Integration
BD --> HRMS : Biometric Input

' Internal System Communications
FAB --> DB : Backend Operations
FAF --> FAB : API Calls
EP --> FAB : API Calls
AC --> FAB : API Calls
PF --> FAB : API Calls
FAEA --> FAB : API Calls

' Data Flow Annotations
note right of EMP : Employee Data\nAttendance Records\nSalary Information\nPersonal Information
note right of ACC : Financial Data\nPayroll Records\nInsurance Information\nTax Calculations
note right of ADM : System Configuration\nUser Management\nSecurity Settings\nAudit Logs
note right of HRM : HR Policies\nEmployee Records\nPerformance Data\nTraining Records

note bottom of DB : Employee Database\nAttendance Database\nPayroll Database\nInsurance Database\nSystem Logs
note bottom of FRS : Face Templates\nRecognition Results\nImage Processing
note bottom of ES : Email Templates\nNotification Queue\nCommunication Logs
note bottom of CS : Video Streams\nImage Capture\nSecurity Footage

@enduml</content>
